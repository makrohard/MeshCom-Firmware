     // Flash rewrite
-    save_settings();
+    save_msgid();
 
     checkVia(aprsmsg);
 
@@ -4093,7 +4093,7 @@ int sendMessage(char *msg_text, int len, const char *src_override, unsigned int
         meshcom_settings.node_msgid=0;
 
