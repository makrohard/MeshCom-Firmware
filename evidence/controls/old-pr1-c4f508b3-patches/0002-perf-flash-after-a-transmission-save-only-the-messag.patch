-        save_settings();
+        save_msgid();
 
         checkVia(aprsmsg);
 
diff --git a/src/nrf52/WisBlock-API.h b/src/nrf52/WisBlock-API.h
index 91cd22eb..eb405e96 100644
--- a/src/nrf52/WisBlock-API.h
+++ b/src/nrf52/WisBlock-API.h
@@ -612,6 +612,8 @@ struct s_meshcomcompat_settings
