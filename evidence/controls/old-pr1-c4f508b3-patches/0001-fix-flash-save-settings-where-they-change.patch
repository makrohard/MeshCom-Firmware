 src/esp32/esp32_flash.h         |  1 +
 src/gps_functions.cpp           | 11 +++++++++++
 src/t-deck-pro/peri_keypad.cpp  | 10 ++++++++++
 src/t-deck/lv_obj_functions.cpp |  4 ++++
