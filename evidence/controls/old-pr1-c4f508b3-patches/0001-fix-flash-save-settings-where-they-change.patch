index 1229ac10..990bbff1 100644
--- a/src/esp32/esp32_flash.h
+++ b/src/esp32/esp32_flash.h
@@ -243,6 +243,7 @@ struct s_meshcom_settings
 extern s_meshcom_settings meshcom_settings;
 
